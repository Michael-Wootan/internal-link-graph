# Copy to .env (never commit .env).

# --- Secrets ---
SHOPIFY_STORE=your-store.myshopify.com
# Admin API token with read/write content and read products
SHOPIFY_ADMIN_TOKEN=
# Optional: weekly summary email
GMAIL_USER=
GMAIL_APP_PASSWORD=
EMAIL_NOTIFY=

# --- Configuration ---
# Public site URL, no trailing slash
SITE_URL=https://www.acmesupply.example
SHOPIFY_BLOG_HANDLE=news
# Blog ID is looked up from the handle when empty; the injector requires it
SHOPIFY_BLOG_ID=
COMPANY_NAME=Acme Supply Co.
# OUTPUT_DIR=./output
# CONFIG_DIR=./config
